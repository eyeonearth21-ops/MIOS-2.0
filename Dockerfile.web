# MIOS 2.0 — Streamlit Web App
# Build:  docker build -f Dockerfile.web -t mios-web .
# Run:    docker run -p 8080:8080 --env-file .env mios-web
# Deploy: see deploy-webapp-gcp.sh

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mios/ ./mios/
COPY app.py .

# Cloud Run injects PORT env var; Streamlit must listen on it
ENV PORT=8080

EXPOSE 8080

CMD streamlit run app.py \
      --server.port=$PORT \
      --server.address=0.0.0.0 \
      --server.headless=true \
      --browser.gatherUsageStats=false
