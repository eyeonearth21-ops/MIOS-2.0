# ─────────────────────────────────────────────────────────────────
# MIOS 2.0 — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── WhatsApp / Twilio Settings ────────────────────────────────────
# 1. Sign up at https://www.twilio.com and create a project.
# 2. From the Console dashboard, copy your Account SID and Auth Token.
# 3. Enable WhatsApp:
#    - Sandbox (free, for testing): use the sandbox number +14155238886
#      and follow the join instructions at console.twilio.com/develop/sms/try-it-out/whatsapp-learn
#    - Production: register a WhatsApp Business number in the Console.
# 4. WHATSAPP_FROM — your Twilio WhatsApp number (include country code, e.g. +14155238886)
# 5. WHATSAPP_TO   — the recipient's WhatsApp number (include country code, e.g. +919876543210)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
WHATSAPP_FROM=+14155238886
WHATSAPP_TO=+919876543210

# ── Scanner Parameters ────────────────────────────────────────────
# Rolling window (trading days) to determine support/resistance
SCANNER_LOOKBACK_DAYS=20

# Minimum volume spike multiplier (1.5 = 50% above average)
SCANNER_VOLUME_SPIKE=1.5

# Minimum absolute % price change to qualify as a breakout
SCANNER_MIN_PRICE_CHG=0.5

# ── Risk Manager Parameters ───────────────────────────────────────
# ATR multiplier for stop-loss distance (1.5 = 1.5 × ATR)
RISK_SL_ATR_MULT=1.5

# Hard cap on stop-loss distance as % of entry price (0.03 = 3%)
RISK_MAX_SL_PCT=0.03

# Target 2 risk:reward multiple — must be ≥ 2.0 to pass the filter
RISK_T2_RR_MULTIPLE=2.0

# ── Alert Thresholds ──────────────────────────────────────────────
# Minimum quality score (0–100) to send a WhatsApp alert
ALERT_MIN_SCORE=70

# ── Scheduler ────────────────────────────────────────────────────
# How often (in seconds) the scheduler checks for pending jobs
SCHEDULER_POLL_SECONDS=30

# ── Logging ───────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
